# Copy to `.env` for local overrides. Do not commit real secrets.
# Used by Docker Compose and (optionally) local scripts.

# --- Graph ---
# Host path to the active graph JSON (mounted into the container)
GRAPH_PATH=./graph/graph.json

# Source tree used by graph generation scripts
SOURCE_PATH=./sample-app

# Output directory for graphify extract / viewer
GRAPH_OUT_DIR=./graph

# Future multi-repo graphs can live under ./graphs/<repo-id>/graph.json
# See docs/SCALING.md

# --- Local HTTP MCP (scripts/start-mcp.ps1) ---
# Must stay loopback for local testing
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_PATH=/mcp

# --- Docker Compose ---
# Host bind address for published ports (local-only)
MCP_HOST_BIND=127.0.0.1
# Host port published to the container MCP port
MCP_HOST_PORT=8765
# Port inside the container (graphify.serve)
MCP_CONTAINER_PORT=8080
# Container listen address (0.0.0.0 required for Docker port publishing)
MCP_CONTAINER_HOST=0.0.0.0

# Optional HTTP API key for Graphify MCP (--api-key / GRAPHIFY_API_KEY)
# GRAPHIFY_API_KEY=
